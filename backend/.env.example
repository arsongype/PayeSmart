# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-local-database-password
DB_NAME=paysmart_db

# JWT Configuration
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-random-secret-at-least-32-characters
JWT_REFRESH_EXPIRES_IN=7d

# Stripe card setup (use Stripe test keys locally; never commit live secret keys)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Server Configuration
PORT=3000
NODE_ENV=development
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MS=60000

# AI service
AI_SERVICE_URL=http://localhost:8120
# Must match AI_API_KEY in ai-service/.env; use a random 32+ character value in production.
AI_API_KEY=local-development-ai-key
# Precision, recall and F1 use administrator-reviewed transactions; no demo scores are used.
ENCRYPTION_KEY=replace-with-a-random-secret-at-least-32-characters
REDIS_URL=redis://localhost:6379

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Email (SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=replace-with-your-smtp-password
SMTP_FROM=gype09@gmail.com

# Observability (optional)
OBSERVE_APP_KEY=your-observe-app-key
OBSERVE_APP_SECRET=your-observe-app-secret
OBSERVE_SERVICE_ID=backend
